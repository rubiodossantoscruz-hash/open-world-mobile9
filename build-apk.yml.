
name: Gerar APK Android

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extrair projeto
        run: |
          unzip -q Open_World_Mobile_v3.39_25MB.zip -d projeto
          test -f projeto/damage334/settings.gradle

      - name: Compilar APK
        working-directory: projeto/damage334
        run: gradle assembleDebug --no-daemon

      - uses: actions/upload-artifact@v4
        with:
          name: Open-World-Mobile-APK
          path: projeto/damage334/app/build/outputs/apk/debug/app-debug.apk
